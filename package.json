{
  "name": "ghost-cli",
  "version": "1.33.1",
  "description": "CLI Tool for installing & updating Ghost",
  "author": "Ghost Foundation",
  "homepage": "https://ghost.org",
  "keywords": [
    "ghost",
    "cli"
  ],
  "files": [
    "bin",
    "lib",
    "extensions",
    "yarn.lock"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryGhost/Ghost-CLI.git"
  },
  "bugs": "https://github.com/TryGhost/Ghost-CLI/issues",
  "contributors": "https://github.com/TryGhost/Ghost-CLI/graphs/contributors",
  "license": "MIT",
  "main": "lib/index.js",
  "bin": {
    "ghost": "./bin/ghost"
  },
  "scripts": {
    "coverage": "vitest run --coverage",
    "lint": "oxlint --quiet && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt .",
    "format": "oxfmt .",
    "test": "vitest run",
    "posttest": "pnpm lint",
    "release": "node scripts/release.js",
    "release-notes": "node scripts/release-notes.js"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "preferGlobal": true,
  "dependencies": {
    "@tryghost/zip": "3.5.15",
    "abbrev": "5.0.0",
    "boxen": "9.0.0",
    "chalk": "6.0.1",
    "cli-table3": "0.5.0",
    "debug": "4.4.3",
    "execa": "10.0.1",
    "find-plugins": "1.1.7",
    "fkill": "10.0.3",
    "global-modules": "2.0.0",
    "ini": "7.0.0",
    "inquirer": "14.2.2",
    "jsonwebtoken": "9.0.3",
    "ky": "1.14.3",
    "listr2": "11.1.1",
    "lodash": "4.18.1",
    "log-symbols": "7.0.1",
    "mysql2": "3.24.5",
    "node-stream-zip": "1.16.0",
    "ora": "9.4.1",
    "package-json": "10.0.1",
    "portfinder": "1.0.38",
    "prettyjson": "1.2.5",
    "read-last-lines": "1.10.0",
    "semver": "7.8.5",
    "symlink-or-copy": "1.3.1",
    "systeminformation": "5.33.15",
    "tail": "2.2.6",
    "tar": "7.5.22",
    "tough-cookie": "6.0.2",
    "which": "7.0.0",
    "yargs": "18.2.0",
    "yarn": "1.22.22"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.2",
    "has-ansi": "6.0.2",
    "nock": "14.0.17",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "proxyquire": "2.1.3",
    "sinon": "22.1.0",
    "tmp": "0.2.7",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@12.9.0+sha512.8f64efa0b792986ca98ae568791bcd7722807e274c4f0c1d9853c62116495c584119db98762a2a5343b1684d361b9ae26fdd16d551666d7635346d3fae830ddd"
}
