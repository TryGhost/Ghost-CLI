{
  "extends": [
    "github>tryghost/renovate-config",
    ":semanticCommitTypeAll(chore)"
  ],
  "ignoreDeps": [
    "cli-table3"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "groupName": "CLI Tools",
      "matchPackageNames": ["chalk", "inquirer", "listr2", "log-symbols", "ora"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "groupName": "Well Known",
      "matchPackageNames": ["debug", "lodash", "semver", "yarn"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Node.js versions are managed manually",
      "matchPackageNames": ["node", "actions/node-versions"],
      "enabled": false
    },
    {
      "description": "Keep ky on v1, other dependencies also rely on v1",
      "matchPackageNames": ["ky"],
      "allowedVersions": "1.x"
    }
  ]
}
